From 8989c33d638dfd3bd4cad9c2dbc8fb2753372d24 Mon Sep 17 00:00:00 2001
From: "root@metal-u15" <root@metal-u15>
Date: Tue, 14 Jul 2026 15:06:47 +0200
Subject: [PATCH] zebra: scope early route queue cleanup to the matching table

connected_remove_kernel_for_connected() intends to remove a kernel route
that is the exact same as an incoming connected route.  Its in-RIB path
is correctly scoped to the vrf table, but the early-queue cleanup
matched pending routes by prefix and type only, discarding same-prefix
kernel routes belonging to unrelated tables (e.g. tables tracked via
ip import-table and redistributed with table-direct) whenever the
matching interface address arrived in the same netlink batch.  The
imported route was then never learned, silently and permanently.

Compare the table id of the queued route entry against the vrf table id
the caller is operating on.  Also move the entry free below the debug
log that dereferences it.

Fixes: FRRouting/frr#22654
---
 zebra/connected.c |  2 +-
 zebra/rib.h       |  3 ++-
 zebra/zebra_rib.c | 21 +++++++++++++++------
 3 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/zebra/connected.c b/zebra/connected.c
index c03bc146a..c13509a5f 100644
--- a/zebra/connected.c
+++ b/zebra/connected.c
@@ -194,7 +194,7 @@ static void connected_remove_kernel_for_connected(afi_t afi, safi_t safi, struct
 	/*
 	 * Needs to be early as that the actual route_node may not exist yet
 	 */
-	rib_meta_queue_early_route_cleanup(p, ZEBRA_ROUTE_KERNEL);
+	rib_meta_queue_early_route_cleanup(p, ZEBRA_ROUTE_KERNEL, zvrf->table_id);
 
 	if (!table)
 		return;
diff --git a/zebra/rib.h b/zebra/rib.h
index e35377a84..247b20e24 100644
--- a/zebra/rib.h
+++ b/zebra/rib.h
@@ -480,7 +480,8 @@ int zebra_rib_queue_evpn_rem_vtep_del(vrf_id_t vrf_id, vni_t vni,
 
 extern void meta_queue_free(struct meta_queue *mq, struct zebra_vrf *zvrf);
 extern int zebra_rib_labeled_unicast(struct route_entry *re);
-extern void rib_meta_queue_early_route_cleanup(const struct prefix *p, int route_type);
+extern void rib_meta_queue_early_route_cleanup(const struct prefix *p, int route_type,
+					       uint32_t table_id);
 extern struct route_table *rib_table_ipv6;
 
 extern uint32_t zebra_rib_meta_queue_size(void);
diff --git a/zebra/zebra_rib.c b/zebra/zebra_rib.c
index ee2d7d5a7..2a264279a 100644
--- a/zebra/zebra_rib.c
+++ b/zebra/zebra_rib.c
@@ -4451,15 +4451,24 @@ static int rib_meta_queue_early_route_add(struct meta_queue *mq, void *data)
 	return 0;
 }
 
-void rib_meta_queue_early_route_cleanup(const struct prefix *p, int route_type)
+void rib_meta_queue_early_route_cleanup(const struct prefix *p, int route_type,
+					uint32_t table_id)
 {
 	struct listnode *node, *nnode;
 	struct zebra_early_route *ere;
 
 	/* Iterate through the early route subqueue */
 	for (ALL_LIST_ELEMENTS(zrouter.mq->subq[META_QUEUE_EARLY_ROUTE], node, nnode, ere)) {
-		/* Check if this entry matches the prefix and route type */
-		if (prefix_same(&ere->p, p) && ere->re->type == route_type) {
+		/*
+		 * Check if this entry matches the prefix, route type and
+		 * table.  The table check matters: a same-prefix kernel
+		 * route in an unrelated table (e.g. one tracked via
+		 * `ip import-table`) must not be discarded because a
+		 * connected route for the prefix showed up in the vrf
+		 * table.
+		 */
+		if (prefix_same(&ere->p, p) && ere->re->type == route_type &&
+		    ere->re->table == table_id) {
 			/* Remove from the list */
 			list_delete_node(zrouter.mq->subq[META_QUEUE_EARLY_ROUTE], node);
 
@@ -4470,15 +4479,15 @@ void rib_meta_queue_early_route_cleanup(const struct prefix *p, int route_type)
 			atomic_fetch_sub_explicit(&zrouter.mq->total_subq[META_QUEUE_EARLY_ROUTE],
 						  1, memory_order_relaxed);
 
-			/* Free the early route memory */
-			early_route_memory_free(ere);
-
 			if (IS_ZEBRA_DEBUG_RIB_DETAILED) {
 				struct vrf *vrf = vrf_lookup_by_id(ere->re->vrf_id);
 
 				zlog_debug("Route %pFX(%s) type %d removed from early route queue",
 					   p, VRF_LOGNAME(vrf), route_type);
 			}
+
+			/* Free the early route memory */
+			early_route_memory_free(ere);
 		}
 	}
 }
-- 
2.55.0

