-    resources:
-      requests:
-        cpu: 10m
-        memory: 20Mi
-    terminationMessagePolicy: FallbackToLogsOnError
-    volumeMounts:
-    - name: frr-sockets
-      mountPath: /var/run/frr
-    - name: frr-conf
-      mountPath: /etc/frr
-    - name: frr-status
-      mountPath: /etc/frr_status
   volumes:
   - name: resource-dir
     hostPath:
@@ -308,12 +106,6 @@ spec:
     emptyDir: {}
   - name: frr-sockets
     emptyDir: {}
-  - name: reloader
-    emptyDir: {}
-  - name: metrics
-    emptyDir: {}
