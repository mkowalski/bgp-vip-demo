From 4ec6515bcd487597d7317a541d9722e24cb089fd Mon Sep 17 00:00:00 2001
From: Mat Kowalski <mko@redhat.com>
Date: Mon, 15 Jun 2026 12:10:12 +0200
Subject: [PATCH 05/26] MCO: add isBGPVIPManagement template function

Adds a template function that checks BareMetalPlatformStatus.VIPManagement
for BGP mode. Used by MachineConfig templates to conditionally place the
frr-k8s static pod manifest in /etc/kubernetes/manifests/ (active) or
/etc/kubernetes/disabled-manifests/ (inactive).
---
 pkg/controller/template/render.go      |  24 ++++++
 pkg/controller/template/render_test.go | 114 +++++++++++++++++++++++++
 2 files changed, 138 insertions(+)

diff --git a/pkg/controller/template/render.go b/pkg/controller/template/render.go
index 39492770f..1caec0fa2 100644
--- a/pkg/controller/template/render.go
+++ b/pkg/controller/template/render.go
@@ -386,6 +386,7 @@ func renderTemplate(config RenderConfig, path string, b []byte) ([]byte, error)
 	funcs["urlHost"] = urlHost
 	funcs["urlPort"] = urlPort
 	funcs["isOpenShiftManagedDefaultLB"] = isOpenShiftManagedDefaultLB
+	funcs["isBGPVIPManagement"] = isBGPVIPManagement
 	funcs["dnsRecordsType"] = dnsRecordsType
 	funcs["cloudPlatformAPIIntLoadBalancerIPs"] = cloudPlatformAPIIntLoadBalancerIPs
 	funcs["cloudPlatformAPILoadBalancerIPs"] = cloudPlatformAPILoadBalancerIPs
@@ -723,6 +724,29 @@ func isOpenShiftManagedDefaultLB(cfg RenderConfig) bool {
 	return false
 }
 
+// isBGPVIPManagement returns true when the cluster is configured to use
+// BGP-based VIP management instead of keepalived/VRRP. This controls
+// whether MCO renders frr-k8s static pod manifests (BGP) or keepalived
+// static pod manifests (default).
+func isBGPVIPManagement(cfg RenderConfig) bool {
+	if cfg.Infra == nil {
+		return false
+	}
+	ps := cfg.Infra.Status.PlatformStatus
+	if ps == nil {
+		return false
+	}
+	switch ps.Type {
+	case configv1.BareMetalPlatformType:
+		if ps.BareMetal == nil {
+			return false
+		}
+		return ps.BareMetal.VIPManagement == "BGP"
+	default:
+		return false
+	}
+}
