 pkg/operator/bootstrap_dependencies.go        |  6 +-
 pkg/operator/bootstrap_test.go                | 21 +++-
 pkg/operator/sync.go                          | 24 ++++-
 pkg/operator/sync_test.go                     | 96 +++++++++++++++++++
 .../on-prem/files/frr-k8s-peers.yaml          |  2 +-
 .../on-prem/files/frr-k8s-peers.yaml          |  2 +-
 7 files changed, 146 insertions(+), 10 deletions(-)

