From 3518dd22c354347c7bf4a3ce97487a042f2af605 Mon Sep 17 00:00:00 2001
From: Mat Kowalski <mko@redhat.com>
Date: Fri, 26 Jun 2026 11:03:42 +0200
Subject: [PATCH 2/6] Add Dockerfile.openshift for downstream builds

Add an OpenShift/ART build variant of the Dockerfile, modeled on
kubernetes-nmstate's build/Dockerfile.openshift:

- Builder: registry.ci.openshift.org/ocp/builder golang-1.26 (RHEL 9)
  instead of the upstream docker.io golang alpine image.
- Runtime: registry.ci.openshift.org/ocp/5.0:base-rhel9 instead of
  scratch, so the image is RHEL-based and suitable for the OCP payload.
- Build with CGO_ENABLED=0 (pure-Go static binary) and GOFLAGS=-mod=mod,
  since this repo is not vendored and the ART builder defaults to
  -mod=vendor.

The upstream Dockerfile is left untouched for community builds.
---
 Dockerfile.openshift | 14 ++++++++++++++
 1 file changed, 14 insertions(+)
 create mode 100644 Dockerfile.openshift

diff --git a/Dockerfile.openshift b/Dockerfile.openshift
new file mode 100644
index 0000000..7908eb9
--- /dev/null
+++ b/Dockerfile.openshift
@@ -0,0 +1,14 @@
+FROM registry.ci.openshift.org/ocp/builder:rhel-9-golang-1.26-openshift-5.0 AS builder
+WORKDIR /go/src/github.com/openshift/kube-vip
+COPY . .
+RUN CGO_ENABLED=0 GO111MODULE=on GOFLAGS=-mod=mod make build
+
+FROM registry.ci.openshift.org/ocp/5.0:base-rhel9
+
+COPY --from=builder /go/src/github.com/openshift/kube-vip/kube-vip /usr/bin/
+
+ENTRYPOINT ["/usr/bin/kube-vip"]
+
+LABEL io.k8s.display-name="kube-vip" \
+      io.k8s.description="Kubernetes Control Plane Virtual IP and Load-Balancer" \
+      org.opencontainers.image.authors="Mateusz Kowalski <mko@redhat.com>"
