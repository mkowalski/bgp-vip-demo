-                                  replacing the default keepalived/VRRP mechanism. When empty or
-                                  "Keepalived", the default keepalived-based VIP management is used.
+                                  replacing the default keepalived/VRRP mechanism. When omitted or set
+                                  to "Keepalived", the default keepalived-based VIP management is used.
                                 enum:
-                                - ""
                                 - Keepalived
                                 - BGP
                                 type: string
