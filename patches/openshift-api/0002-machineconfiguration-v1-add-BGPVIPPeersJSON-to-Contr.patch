+                type: string
               cloudProviderCAData:
                 description: cloudProviderCAData specifies the cloud provider CA data
                 format: byte
@@ -2087,10 +2097,9 @@ spec:
                                   vipManagement indicates which VIP management mechanism is active
                                   on this cluster. When set to "BGP", kube-vip (Routing Table Mode)
