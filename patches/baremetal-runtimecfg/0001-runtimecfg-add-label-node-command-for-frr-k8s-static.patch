From 50e5cc36cd1c4e595ae5afc1690501d3de3200d8 Mon Sep 17 00:00:00 2001
From: Mat Kowalski <mko@redhat.com>
Date: Mon, 15 Jun 2026 14:59:31 +0200
Subject: [PATCH 1/4] runtimecfg: add label-node command for frr-k8s static pod

---
 cmd/runtimecfg/label-node.go | 96 ++++++++++++++++++++++++++++++++++++
 1 file changed, 96 insertions(+)
 create mode 100644 cmd/runtimecfg/label-node.go

diff --git a/cmd/runtimecfg/label-node.go b/cmd/runtimecfg/label-node.go
new file mode 100644
index 0000000..731dbfd
--- /dev/null
+++ b/cmd/runtimecfg/label-node.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/openshift/baremetal-runtimecfg/pkg/utils"
+	"github.com/spf13/cobra"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/kubernetes"
+)
+
+var labelNodeCmd = &cobra.Command{
+	Use:   "label-node [path to kubeconfig]",
+	Short: "Labels the local node to indicate frr-k8s static pod presence",
+	Long: `Adds a label to the local Kubernetes node to signal that an frr-k8s
+static pod is running on this node. This label is used by the frr-k8s
+DaemonSet's anti-affinity rule to avoid scheduling on nodes that already
+have the static pod.
+
+The node name is read from the NODE_NAME environment variable.
+The command retries with backoff if the API server is not yet available.`,
+	Args: cobra.ExactArgs(1),
+	RunE: runLabelNode,
+}
+
+var labelNodeLabel string
+
+func init() {
+	labelNodeCmd.Flags().StringVar(&labelNodeLabel, "label", "network.openshift.io/frr-k8s-static-pod", "Label to apply to the node (key only, value is empty string)")
+	rootCmd.AddCommand(labelNodeCmd)
+}
+
+func runLabelNode(cmd *cobra.Command, args []string) error {
+	kubeconfigPath := args[0]
+	nodeName := os.Getenv("NODE_NAME")
+	if nodeName == "" {
+		return fmt.Errorf("NODE_NAME environment variable is not set")
+	}
+
+	// Split label into key (value is always empty string for presence-based labels)
+	labelKey := labelNodeLabel
+	if strings.Contains(labelKey, "=") {
+		parts := strings.SplitN(labelKey, "=", 2)
+		labelKey = parts[0]
+	}
+
+	log.Infof("Labeling node %s with %s", nodeName, labelKey)
+
+	// Retry with backoff -- during bootstrap the API server may not be available yet
+	var lastErr error
+	for attempt := 0; attempt < 30; attempt++ {
+		err := applyNodeLabel(kubeconfigPath, nodeName, labelKey)
+		if err == nil {
+			log.Infof("Successfully labeled node %s with %s", nodeName, labelKey)
+			return nil
+		}
+		lastErr = err
+		backoff := time.Duration(attempt+1) * 2 * time.Second
+		if backoff > 30*time.Second {
+			backoff = 30 * time.Second
+		}
+		log.Warnf("Failed to label node %s (attempt %d/30): %v, retrying in %v", nodeName, attempt+1, err, backoff)
+		time.Sleep(backoff)
+	}
+	return fmt.Errorf("failed to label node %s after 30 attempts: %v", nodeName, lastErr)
+}
+
+func applyNodeLabel(kubeconfigPath, nodeName, labelKey string) error {
+	config, err := utils.GetClientConfig("", kubeconfigPath)
+	if err != nil {
+		return fmt.Errorf("failed to get client config: %v", err)
+	}
+
+	clientset, err := kubernetes.NewForConfig(config)
+	if err != nil {
+		return fmt.Errorf("failed to create clientset: %v", err)
+	}
+
+	// Use JSON merge patch to add the label
+	escapedKey := strings.ReplaceAll(labelKey, "/", "~1")
+	patch := []byte(fmt.Sprintf(`[{"op":"add","path":"/metadata/labels/%s","value":""}]`, escapedKey))
+
+	_, err = clientset.CoreV1().Nodes().Patch(
+		context.TODO(),
+		nodeName,
+		types.JSONPatchType,
+		patch,
+		metav1.PatchOptions{},
+	)
+	return err
+}
