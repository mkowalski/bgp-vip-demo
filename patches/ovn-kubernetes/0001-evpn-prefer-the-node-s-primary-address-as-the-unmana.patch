From 3cf8a965bcdaaf3e7c221d489524cdaf002b5477 Mon Sep 17 00:00:00 2001
From: Mat Kowalski <mko@redhat.com>
Date: Fri, 9 Oct 2026 18:33:56 +0200
Subject: [PATCH 1/2] evpn: prefer the node's primary address as the unmanaged
 VTEP IP

When several node addresses fall inside an unmanaged VTEP's CIDRs,
pickVTEPIP drops keepalived-labelled and IFA_F_SECONDARY addresses and
then takes the lowest remaining one. That only recognises VIPs installed
by keepalived on IPv4. kube-vip in routing-table mode installs the
cluster API/Ingress VIP as a plain unlabelled /32, and on IPv6 no VIP
can be recognised at all: IFA_LABEL is an IPv4-only attribute and
IFA_F_SECONDARY is IFA_F_TEMPORARY. VIPs are conventionally low in the
subnet, so they win the sort: every control plane node then sources
VXLAN from the API VIP and every worker from the Ingress VIP, cross-node
EVPN traffic never arrives, and the VTEP IP follows the VIP as it moves
between nodes.

The node's primary interface address (k8s.ovn.org/node-primary-ifaddr)
is never a VIP. Prefer it whenever it is one of the candidates; keep
the existing lowest-address selection for VTEP CIDRs that do not
contain the primary address (secondary networks), where nothing
changes.

Assisted-By: Claude Fable 5
Signed-off-by: Mat Kowalski <mko@redhat.com>
---
 .../controllers/evpn/evpn_node_controller.go  | 38 ++++++++++
 .../evpn/evpn_node_controller_test.go         | 75 +++++++++++++++++++
 2 files changed, 113 insertions(+)

diff --git a/go-controller/pkg/node/controllers/evpn/evpn_node_controller.go b/go-controller/pkg/node/controllers/evpn/evpn_node_controller.go
index fc3de0e36..5f8e02430 100644
--- a/go-controller/pkg/node/controllers/evpn/evpn_node_controller.go
+++ b/go-controller/pkg/node/controllers/evpn/evpn_node_controller.go
@@ -919,6 +919,15 @@ func (c *Controller) pickVTEPIP(matches []net.IP, family int) (net.IP, error) {
 			filtered = append(filtered, ip)
 		}
 	}
+	// VIPs that are not keepalived-labelled (e.g. kube-vip in routing-table
+	// mode, or any VIP on IPv6 where labels do not exist) survive the filter
+	// above and, being conventionally low in the subnet, would win the sort.
+	// The node's primary interface address is never a VIP: prefer it.
+	if primary := c.nodePrimaryIP(family); primary != nil &&
+		slices.ContainsFunc(filtered, func(ip net.IP) bool { return ip.Equal(primary) }) {
+		klog.Infof("Selecting node primary address %s as VTEP IP (family %d)", primary, family)
+		return primary, nil
+	}
 	slices.SortFunc(filtered, func(a, b net.IP) int {
 		addrA, _ := netip.AddrFromSlice(a)
 		addrB, _ := netip.AddrFromSlice(b)
@@ -931,6 +940,35 @@ func (c *Controller) pickVTEPIP(matches []net.IP, family int) (net.IP, error) {
 
 }
 
+// nodePrimaryIP returns the node's primary interface address for the given
+// family from the k8s.ovn.org/node-primary-ifaddr annotation, or nil when it
+// is not available; callers fall back to their default selection.
+func (c *Controller) nodePrimaryIP(family int) net.IP {
+	node, err := c.watchFactory.GetNode(c.nodeName)
+	if err != nil {
+		klog.V(4).Infof("Failed to get node %s for primary address lookup: %v", c.nodeName, err)
+		return nil
+	}
+	ifAddr, err := util.GetNodeIfAddrAnnotation(node)
+	if err != nil {
+		klog.V(4).Infof("Node %s has no usable primary interface address annotation: %v", c.nodeName, err)
+		return nil
+	}
+	cidr := ifAddr.IPv4
+	if family == netlink.FAMILY_V6 {
+		cidr = ifAddr.IPv6
+	}
+	if cidr == "" {
+		return nil
+	}
+	ip, _, err := net.ParseCIDR(cidr)
+	if err != nil {
+		klog.V(4).Infof("Node %s primary interface address %q is not a valid CIDR: %v", c.nodeName, cidr, err)
+		return nil
+	}
+	return ip
+}
+
